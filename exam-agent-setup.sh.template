#!/usr/bin/env bash
set -euo pipefail

AGENT_REPO="${AGENT_REPO}"
MANAGER_URL="${MANAGER_URL}"
AGENT_PASSWORD="${AGENT_PASSWORD}"

AGENT_USER="exam-agent"

SETUP_SCRIPT="/usr/local/sbin/exam-agent-setup.sh"
SETUP_MARKER="/etc/exam-appliance/setup-complete"
ROOT_PROFILE="/root/.bash_profile"


#
# ---------------------------------------------------------------------------
# FIRST-BOOT MODE
# ---------------------------------------------------------------------------
#

if [[ ! -t 0 ]]; then
    echo "Installing exam-agent first-login setup..."

    mkdir -p /etc/exam-appliance

    install -m 0755 "$0" "$SETUP_SCRIPT"

    touch "$ROOT_PROFILE"

    if ! grep -qF "$SETUP_SCRIPT" "$ROOT_PROFILE"; then
        cat >> "$ROOT_PROFILE" <<EOF

# Exam appliance initial setup
if [ -x "$SETUP_SCRIPT" ] && [ ! -f "$SETUP_MARKER" ]; then
    "$SETUP_SCRIPT"
fi
EOF
    fi

    echo "First-login setup installed."
    exit 0
fi


#
# ---------------------------------------------------------------------------
# FIRST-LOGIN MODE
# ---------------------------------------------------------------------------
#

if [[ "$(id -u)" -ne 0 ]]; then
    echo "Setup must be run as root."
    exit 1
fi

if [[ -f "$SETUP_MARKER" ]]; then
    exit 0
fi

echo
echo "========================================"
echo "          Exam Agent Setup"
echo "========================================"
echo

echo "Hostname: $(hostname -f)"
echo


#
# ---------------------------------------------------------------------------
# PROXMOX REPOSITORIES
# ---------------------------------------------------------------------------
#

echo "Configuring Proxmox repositories..."

rm -f /etc/apt/sources.list.d/pve-enterprise.sources
rm -f /etc/apt/sources.list.d/ceph.sources

cat > /etc/apt/sources.list.d/pve-no-subscription.sources <<EOF
Types: deb
URIs: http://download.proxmox.com/debian/pve
Suites: trixie
Components: pve-no-subscription
Signed-By: /usr/share/keyrings/proxmox-archive-keyring.gpg
EOF


#
# ---------------------------------------------------------------------------
# PACKAGES
# ---------------------------------------------------------------------------
#

echo "Installing dependencies..."

apt-get update

apt-get install -y \
    git \
    nodejs \
    npm \
    sudo \
    xorg \
    xinit \
    x11-utils \
    virt-viewer \
    jq \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good


#
# ---------------------------------------------------------------------------
# AGENT USER
# ---------------------------------------------------------------------------
#

echo "Creating exam-agent user..."

if ! id "$AGENT_USER" >/dev/null 2>&1; then
    useradd \
        --create-home \
        --shell /bin/bash \
        "$AGENT_USER"
fi

# Allow the agent to read /etc/pve/pve-root-ca.pem.
usermod -aG www-data "$AGENT_USER"

echo "${AGENT_USER}:${AGENT_PASSWORD}" | chpasswd


#
# ---------------------------------------------------------------------------
# AGENT
# ---------------------------------------------------------------------------
#

echo "Installing exam-agent..."

if [[ ! -d /opt/exam-agent/.git ]]; then
    git clone "$AGENT_REPO" /opt/exam-agent
fi

cd /opt/exam-agent

npm install

# The agent owns its application directory.
chown -R "$AGENT_USER:$AGENT_USER" /opt/exam-agent

# show-vm.sh is executed as root through sudo.
# It must therefore not be writable by exam-agent.
chown root:root /opt/exam-agent/show-vm.sh
chmod 0755 /opt/exam-agent/show-vm.sh


#
# ---------------------------------------------------------------------------
# SHOW-VM PERMISSIONS
# ---------------------------------------------------------------------------
#

echo "Configuring show-vm permissions..."

cat > /etc/sudoers.d/exam-agent <<'EOF'
exam-agent ALL=(root) NOPASSWD: /opt/exam-agent/show-vm.sh *
EOF

chmod 0440 /etc/sudoers.d/exam-agent

visudo -cf /etc/sudoers.d/exam-agent


#
# ---------------------------------------------------------------------------
# CONFIGURATION
# ---------------------------------------------------------------------------
#

echo "Writing exam-agent configuration..."

mkdir -p /etc/exam-agent

cat > /etc/exam-agent/config <<EOF
MANAGER_URL=$MANAGER_URL
EOF

chown root:"$AGENT_USER" /etc/exam-agent
chmod 0750 /etc/exam-agent

chown root:"$AGENT_USER" /etc/exam-agent/config
chmod 0640 /etc/exam-agent/config


#
# ---------------------------------------------------------------------------
# SYSTEMD
# ---------------------------------------------------------------------------
#

echo "Installing exam-agent systemd service..."

cat > /etc/systemd/system/exam-agent.service <<EOF
[Unit]
Description=Exam Agent
After=network-online.target pve-cluster.service
Wants=network-online.target
Requires=pve-cluster.service

[Service]
Type=simple
User=$AGENT_USER
Group=$AGENT_USER

WorkingDirectory=/opt/exam-agent
EnvironmentFile=/etc/exam-agent/config

ExecStart=/usr/bin/node /opt/exam-agent/index.js

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable exam-agent.service


#
# ---------------------------------------------------------------------------
# CLEANUP
# ---------------------------------------------------------------------------
#

echo "Cleaning up setup state..."

# Remove files from any previous/manual display setup.
rm -f /root/.xinitrc
rm -f /tmp/exam-xinitrc
rm -f /tmp/exam-*.vv


#
# ---------------------------------------------------------------------------
# DONE
# ---------------------------------------------------------------------------
#

mkdir -p /etc/exam-appliance
touch "$SETUP_MARKER"

echo
echo "========================================"
echo " Setup completed successfully"
echo "========================================"
echo
echo "Hostname: $(hostname -f)"
echo "Manager:  $MANAGER_URL"
echo
echo "Rebooting..."
echo

sleep 3
reboot
